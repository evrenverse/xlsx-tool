{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evrenverse/xlsx-tool/blob/main/internal/commands/schemas/batch.schema.json",
  "title": "xlsx-tool batch input",
  "type": "array",
  "maxItems": 100000,
  "items": {
    "type": "object",
    "required": ["sheet", "cell"],
    "properties": {
      "sheet": {"type": "string", "minLength": 1},
      "cell": {"type": "string", "pattern": "^\\$?[A-Za-z]{1,3}\\$?[1-9][0-9]*$"},
      "value": {
        "type": ["string", "number", "boolean"]
      },
      "formula": {"type": "string", "minLength": 1}
    },
    "oneOf": [
      {"required": ["value"], "not": {"required": ["formula"]}},
      {"required": ["formula"], "not": {"required": ["value"]}}
    ],
    "additionalProperties": false
  }
}
